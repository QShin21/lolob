{
  "name": "riftcast-director",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "英雄联盟本地赛事导播工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n SERVICE,UI \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "release:win": "node scripts/build-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "start": "tsx server/index.ts",
    "predesktop": "node scripts/ensure-electron.cjs && node scripts/ensure-obs.cjs && node scripts/build-audio-bridge.cjs && node scripts/ensure-vbcable.cjs",
    "setup:obs": "node scripts/ensure-obs.cjs",
    "setup:audio": "node scripts/build-audio-bridge.cjs && node scripts/ensure-vbcable.cjs",
    "prepare:champion-art": "node scripts/prepare-champion-art.mjs",
    "prepare:offline": "node scripts/prepare-offline.mjs",
    "verify:production": "node scripts/verify-production-workflow.mjs",
    "verify:ui-theme": "node scripts/verify-ui-theme.mjs",
    "verify:frontend-safety": "node scripts/verify-frontend-safety.mjs",
    "verify:custom-scenes": "node scripts/verify-custom-scenes.mjs",
    "verify:champion-art": "node scripts/prepare-champion-art.mjs --verify",
    "verify:broadcast-controls": "node scripts/verify-broadcast-controls.mjs",
    "desktop": "electron .",
    "test": "tsx --test server/*.test.ts",
    "check": "tsc --noEmit",
    "verify:style-packs": "node scripts/verify-style-packs.mjs",
    "export:style-pack": "node scripts/export-style-pack.mjs",
    "verify:builtin-styles": "node scripts/verify-builtin-styles.mjs",
    "verify:builtin-assets": "node scripts/verify-builtin-assets.mjs",
    "verify:builtin-contracts": "node scripts/verify-builtin-contracts.mjs"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "egoroof-blowfish": "4.0.3",
    "express": "^5.1.0",
    "fzstd": "0.1.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "obs-websocket-js": "^5.0.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.5",
    "unzipper": "0.12.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/archiver": "6.0.4",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.3",
    "ajv": "8.20.0",
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
